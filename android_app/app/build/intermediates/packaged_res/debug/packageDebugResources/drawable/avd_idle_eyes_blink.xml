<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="60dp"
            android:height="30dp"
            android:viewportWidth="60"
            android:viewportHeight="30">
            <!-- Left Eye -->
            <path
                android:name="eye_left_path"
                android:fillColor="#00F5FF"
                android:pathData="M 0,9 C 0,4 4,0 9,0 C 14,0 18,4 18,9 L 18,21 C 18,26 14,30 9,30 C 4,30 0,26 0,21 Z" />
            <!-- Right Eye -->
            <path
                android:name="eye_right_path"
                android:fillColor="#00F5FF"
                android:pathData="M 42,9 C 42,4 46,0 51,0 C 56,0 60,4 60,9 L 60,21 C 60,26 56,30 51,30 C 46,30 42,26 42,21 Z" />
        </vector>
    </aapt:attr>

    <!-- Left Eye Morphing -->
    <target android:name="eye_left_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="300"
                android:startOffset="2500"
                android:valueFrom="M 0,9 C 0,4 4,0 9,0 C 14,0 18,4 18,9 L 18,21 C 18,26 14,30 9,30 C 4,30 0,26 0,21 Z"
                android:valueTo="M 0,14 C 0,13 4,13 9,13 C 14,13 18,13 18,14 L 18,16 C 18,17 14,17 9,17 C 4,17 0,17 0,16 Z"
                android:valueType="pathType"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>

    <!-- Right Eye Morphing -->
    <target android:name="eye_right_path">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="pathData"
                android:duration="300"
                android:startOffset="2500"
                android:valueFrom="M 42,9 C 42,4 46,0 51,0 C 56,0 60,4 60,9 L 60,21 C 60,26 56,30 51,30 C 46,30 42,26 42,21 Z"
                android:valueTo="M 42,14 C 42,13 46,13 51,13 C 56,13 60,13 60,14 L 60,16 C 60,17 56,17 51,17 C 46,17 42,17 42,16 Z"
                android:valueType="pathType"
                android:repeatCount="infinite"
                android:repeatMode="reverse"
                android:interpolator="@android:anim/accelerate_decelerate_interpolator" />
        </aapt:attr>
    </target>
</animated-vector>
